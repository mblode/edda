DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres

SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# HS256 secret from Supabase dashboard → Settings → API → JWT Secret.
# Required by apps/api (for bearer-token verification) and apps/docs
# (for local cookie verification in getDashboardSession).
SUPABASE_JWT_SECRET=

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_API_URL=http://localhost:4000
DOCS_APP_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=

# Platform PostHog (Edda / blode.md product telemetry only, never tenant projects).
# Uses the same public project as blode.co (PostHog project 529494). Token and
# ui_host are hardcoded (apps/web/lib/posthog-key.ts and @repo/common).
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN and NEXT_PUBLIC_POSTHOG_UI_HOST are unused.
#
# Optional reverse proxy for api_host (ad-blocker bypass), same pattern as blode.co.
# Unset falls back to https://s.blode.md. Do not point this at a customer PostHog host.
NEXT_PUBLIC_POSTHOG_HOST=https://s.blode.md
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=blode.md
NEXT_PUBLIC_PLATFORM_DOCS_TENANT_SLUG=docs

PLATFORM_ROOT_DOMAIN=blode.md
PLATFORM_ASSET_PREFIX=
PREFER_CUSTOM_DOMAIN=false
REDIRECT_PRIMARY_DOMAIN=false
EDGE_CONFIG=
VERCEL_TOKEN=
VERCEL_EDGE_CONFIG_ID=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=
VERCEL_AUTO_WWW_REDIRECT=false
ADMIN_API_TOKEN=
BLOB_READ_WRITE_TOKEN=

# IndexNow (apps/web marketing). Key file is served at https://blode.md/<key>.txt
# Example: INDEXNOW_KEY=01234567-89ab-cdef-0123-456789abcdef
INDEXNOW_KEY=
# Bearer secret for POST /indexnow/submit. Empty disables the endpoint (503).
# Example: INDEXNOW_SUBMIT_SECRET=replace-with-a-long-random-string
INDEXNOW_SUBMIT_SECRET=

# Supabase GitHub OAuth provider
SUPABASE_AUTH_GITHUB_CLIENT_ID=
SUPABASE_AUTH_GITHUB_SECRET=

# Blode.md GitHub App (for repo install + auto-deploy)
GITHUB_APP_SLUG=
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_INSTALL_STATE_SECRET=

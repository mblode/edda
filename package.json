{
  "name": "blodemd",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "prepare": "test -d .git && lefthook install || true",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "check-types": "turbo check-types",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "build:packages": "turbo build --filter=./packages/*",
    "pretest": "npm run build:packages",
    "test": "vitest run && npm run test:e2e",
    "pretest:unit": "npm run build:packages",
    "test:unit": "vitest run --project unit --project unit-web",
    "pretest:component": "npm run build:packages",
    "test:component": "vitest run --project component --passWithNoTests",
    "pretest:integration": "npm run build:packages",
    "test:integration": "vitest run --project integration",
    "pretest:smoke": "npm run build:packages",
    "test:smoke": "vitest run --project smoke",
    "pretest:e2e": "turbo build --filter=web --filter=docs --filter=dashboard",
    "test:e2e": "playwright test",
    "test:instant": "E2E_APPS=web playwright test e2e/web-instant.spec.ts",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:push": "npm run db:local:push --workspace=packages/db",
    "db:seed": "npm run db:local:seed --workspace=packages/db",
    "knip": "DATABASE_URL=postgresql://localhost/dummy knip"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@next/playwright": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "jsdom": "^30.1.1",
    "knip": "6.37.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2",
    "ultracite": "7.12.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@12.0.1"
}

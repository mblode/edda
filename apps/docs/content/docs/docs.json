{
  "$schema": "https://blode.md/docs.json",
  "name": "Edda",
  "slug": "docs",
  "description": "Edda: knowledge docs for agents, published on merge. Write MDX in git; the merge publishes the HTML and the Markdown agents fetch.",
  "favicon": "icon0.svg",
  "seo": {
    "siteUrl": "https://blode.md/docs"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "grok",
      "aistudio"
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://blode.co/edda"
      },
      {
        "label": "Pricing",
        "href": "https://blode.md/pricing"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/mblode/edda"
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart", "how-it-works"]
          },
          {
            "group": "Writing content",
            "pages": [
              "content/mdx-basics",
              "content/frontmatter",
              "content/code-blocks"
            ]
          },
          {
            "group": "Configuration",
            "pages": [
              "configuration/docs-json",
              "configuration/navigation",
              "configuration/theming"
            ]
          },
          {
            "group": "Deployment",
            "pages": ["deployment/push", "deployment/ci"]
          },
          {
            "group": "Features",
            "pages": [
              "features/agent-readable-docs",
              "features/custom-domains",
              "features/search",
              "features/seo",
              "features/analytics",
              "features/openapi",
              "features/collections",
              "features/dev-server"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/proxy-vercel",
              "guides/proxy-cloudflare",
              "guides/proxy-nginx",
              "guides/migrate-from-mintlify"
            ]
          },
          {
            "group": "API",
            "pages": ["api/overview"]
          }
        ]
      },
      {
        "tab": "Components",
        "groups": [
          {
            "group": "Content",
            "pages": [
              "components/callout",
              "components/card",
              "components/accordion",
              "components/tabs",
              "components/steps",
              "components/expandable"
            ]
          },
          {
            "group": "Code",
            "pages": ["components/code-group", "components/installer"]
          },
          {
            "group": "Layout",
            "pages": [
              "components/columns",
              "components/frame",
              "components/tree"
            ]
          },
          {
            "group": "Data display",
            "pages": ["components/type-table"]
          }
        ]
      },
      {
        "tab": "CLI reference",
        "groups": [
          {
            "group": "CLI",
            "pages": [
              "cli/overview",
              "cli/login",
              "cli/logout",
              "cli/whoami",
              "cli/new",
              "cli/push",
              "cli/dev",
              "cli/validate",
              "cli/analytics"
            ]
          }
        ]
      }
    ]
  }
}

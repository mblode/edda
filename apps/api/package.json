{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run sh -c 'set -a && . .env && set +a && tsx watch src/index.ts'",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "backfill:edge-config": "sh -c 'set -a; [ -f ./.env ] && . ./.env; [ -f ./.env.local ] && . ./.env.local; set +a; tsx scripts/backfill-edge-config.ts'",
    "test:unit": "sh -c 'cd ../.. && npm run build:packages && vitest run --config vitest.config.ts --project unit apps/api/src'",
    "test:integration": "sh -c 'cd ../.. && npm run build:packages && vitest run --config vitest.config.ts --project integration apps/api/src'",
    "test:smoke": "sh -c 'cd ../.. && npm run build:packages && vitest run --config vitest.config.ts --project smoke apps/api/src'",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.1",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^22.0.1",
    "@repo/common": "^0.0.0",
    "@repo/contracts": "^0.0.0",
    "@repo/db": "^0.0.0",
    "@repo/mdx-compiler": "^0.0.0",
    "@repo/models": "^0.0.0",
    "@repo/prebuild": "^0.0.0",
    "@repo/previewing": "^0.0.0",
    "@vercel/blob": "^2.8.0",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@repo/typescript-config": "^0.0.0",
    "@types/node": "^26.5.1",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "ultracite": "7.11.1"
  },
  "engines": {
    "node": "24.x"
  }
}

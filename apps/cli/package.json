{
  "name": "blodemd",
  "version": "0.2.1",
  "description": "Blode.md CLI: git-native docs, published on merge",
  "repository": {
    "type": "git",
    "url": "https://github.com/mblode/blodemd"
  },
  "bin": {
    "blodemd": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "node scripts/prepare-package.mjs",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt .",
    "test:unit": "sh -c 'cd ../.. && vitest run --config vitest.config.ts --project unit apps/cli/src'"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "open": "^11.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@repo/common": "^0.0.0",
    "@repo/contracts": "^0.0.0",
    "@repo/models": "^0.0.0",
    "@repo/previewing": "^0.0.0",
    "@repo/typescript-config": "^0.0.0",
    "@types/node": "^26.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "tsdown": "^0.23.0",
    "ultracite": "7.11.1"
  },
  "engines": {
    "node": "24.x"
  }
}
